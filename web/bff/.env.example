# bff/.env.example
# Copy to .env and fill in real values.

# Postgres connection string, driver-adapter mode (see src/prisma/db.ts).
# This default matches the repo-root docker-compose.yml exactly — run
# `docker compose up -d` (from the repo root) and this works as-is, no
# editing needed. Point it at a different Postgres (a local install, a
# hosted free tier) instead if you'd rather not use Docker.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scaffold"

# Google OAuth (Login with Google) — bring your own credentials from Google
# Cloud Console > Google Auth Platform > Clients. Redirect URI must match
# exactly what's registered there. Nothing else about login works until
# these are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://localhost:5173/auth/google/callback"
