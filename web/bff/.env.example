# bff/.env.example
# Copy to .env and fill in real values.

# Postgres connection string, driver-adapter mode (see src/prisma/db.ts).
# For local dev, point this at any Postgres you have (a local install, a
# `docker run -p 5432:5432 postgres:16`, or a hosted free tier).
DATABASE_URL="postgresql://postgres:<password>@localhost:5432/scaffold"

# Google OAuth (Login with Google) — bring your own credentials from Google
# Cloud Console > Google Auth Platform > Clients. Redirect URI must match
# exactly what's registered there. Nothing else about login works until
# these are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://localhost:5173/auth/google/callback"
