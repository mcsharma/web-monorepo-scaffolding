{
  "name": "@scaffold/bff",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "pnpm run generate",
    "dev": "concurrently \"tsx watch src/index.ts\" \"pnpm run typecheck:watch\" \"pnpm run studio\"",
    "typecheck:watch": "tsc --noEmit --watch --preserveWatchOutput --pretty",
    "typecheck": "tsc --noEmit",
    "generate": "prisma generate && node scripts/postgenerate.mjs",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "prisma db seed",
    "studio": "prisma studio",
    "build": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@pothos/core": "^4.12.0",
    "@pothos/plugin-prisma": "^4.14.2",
    "@pothos/plugin-relay": "^4.7.0",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "google-auth-library": "^10.9.0",
    "graphql": "^16.12.0",
    "graphql-yoga": "^5.18.0",
    "helmet": "^8.1.0",
    "pg": "^8.19.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "@types/pg": "^8.18.0",
    "concurrently": "^9.2.1",
    "prisma": "^7.4.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
