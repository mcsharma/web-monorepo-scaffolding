{
  "name": "@scaffold/frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"pnpm run typecheck:watch\"",
    "typecheck:watch": "tsc --noEmit --watch --preserveWatchOutput --pretty",
    "typecheck": "relay-compiler && tsc --noEmit",
    "build": "tsc && relay-compiler && vite build",
    "preview": "vite preview",
    "relay": "relay-compiler --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-relay": "^20.1.1",
    "react-router": "^8.2.0",
    "relay-runtime": "^20.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-relay": "^18.2.1",
    "@types/relay-runtime": "^20.1.1",
    "@vitejs/plugin-react": "^5.1.4",
    "relay-compiler": "^20.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-relay": "^2.1.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "relay": {
    "src": "./src",
    "schema": "../bff/src/__generated__/schema.graphql",
    "language": "typescript",
    "eagerEsModules": true
  }
}
