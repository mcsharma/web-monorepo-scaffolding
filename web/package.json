{
  "name": "scaffold",
  "private": true,
  "type": "module",
  "description": "pnpm + Express/GraphQL-Yoga/Pothos/Prisma + React/Relay starter scaffold",
  "scripts": {
    "typecheck": "pnpm --filter @scaffold/bff typecheck && pnpm --filter @scaffold/frontend typecheck",
    "dev": "concurrently \"pnpm run --filter @scaffold/bff dev\" \"wait-on tcp:4000 && pnpm run --filter @scaffold/frontend dev\" \"pnpm run --filter @scaffold/frontend relay\"",
    "build": "pnpm run -r build",
    "db:migrate": "pnpm --filter @scaffold/bff migrate",
    "db:generate": "pnpm --filter @scaffold/bff generate",
    "relay": "pnpm --filter @scaffold/frontend relay",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-relay": "^2.0.0",
    "globals": "^17.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "wait-on": "^8.0.5"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
